MISTRAL_API_KEY=replace-with-your-key
OPENCODE_MODEL=mistral/mistral-large-4
OPENCODE_BINARY=opencode
DATA_DIR=./data
MAX_UPLOAD_MB=25
ANALYSIS_TIMEOUT_SECONDS=1800
ANALYSIS_MAX_STEPS=120
ANALYSIS_MAX_TOOL_CALLS=100
TOOL_TIMEOUT_SECONDS=120
SANDBOX_IMAGE=malanalyzer-tools:local
SANDBOX_BACKEND=docker
SANDBOX_MEMORY_MB=2048
DOCKER_BINARY=docker
MAX_ATTEMPTS=2
WORKER_CONCURRENCY=1
# Run a separate worker for deployment; local development can run it inside FastAPI.
EMBEDDED_WORKER=true
# If set, uploads require this value in the X-API-Key header. Reports stay public.
UPLOAD_API_KEY=
